# Xoch workspace
.xoch/

# Alternative gitignore patterns (choose based on your team's needs):
# .xoch/context/              # Share glossaries, ignore context
# .xoch/context/current.md    # Share glossaries + context folders, ignore active task pointer

# Node modules (if testing)
node_modules/

# install.js test scratch (in-repo so node's coverage reporter tracks it;
# cleaned up per-test, this is just a crash-path safety net)
.install-test-scratch/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
